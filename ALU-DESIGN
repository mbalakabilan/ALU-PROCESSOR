//----->PC
module turbo_cpu(
input clk,
input reset,
output[0:3]pc
);
wire[0:3]pc_wire;
wire[0:15]ins_wire;
wire[0:3]operation_wire;
wire[0:3]src_1_wire;
wire[0:3]src_2_wire;
wire[0:3]store_wire;
wire[0:3]select_wire;
wire write_wire;
wire[0:15]read_data1_wire;
wire[0:15]read_data2_wire;
wire[0:15]write_data_wire;
wire[0:15]result_wire;
wire[0:15]read_data_wire;
wire[0:15]alu_result;
wire mem_read;
wire mem_write;
wire[0:3] address;




//-----BLOCK 1--PC---------//

turbo b1(
.reset(reset),
.clk(clk),
.pc(pc_wire));

//-----INSTRUCTION -BLOCK 2----------//

ins b2(
.adress(pc_wire),.instruct(ins_wire));

//-------DECODER-BLOCK 3--------//

dec b3(
.instruction(ins_wire),
.operation(operation_wire),
.src_1(src_1_wire),
.src_2(src_2_wire),
.store(store_wire),
.select(select_wire),
.write(write_wire));

//---------REGISTER_FILE---BLOCK-4---------//

reg_file b4(
.clk(clk),
.reset(reset),
.write_enable(write_wire),
.read_addres1(src_1_wire),
.read_addres2(src_2_wire),
.write_adress(store_wire),
.read_data1(read_data1_wire),
.read_data2(read_data2_wire),
.write_data(write_data_wire));

//---------ALU--BLOCK-5--------------------///

alu b5(
.a(read_data1_wire),
.b(read_data2_wire),
.operation(operation_wire),
.result(result_wire));

//----------DATA-MEMORY-6---------------------////

